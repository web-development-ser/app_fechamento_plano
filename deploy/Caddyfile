# Proxy HTTPS do TEGAD (necessário para o PWA: instalação, service worker e cache offline).
# Certificado emitido pela CA interna do Caddy para os endereços em TEGAD_ENDERECOS (.env).
# Os aparelhos precisam confiar na CA uma vez: baixe em https://<servidor>:5001/tegad-ca.crt
{
	local_certs
	skip_install_trust
	auto_https disable_redirects
	servers {
		listener_wrappers {
			# quem acessar http://<servidor>:5001 é redirecionado para https:// na mesma porta
			http_redirect
			tls
		}
	}
}

{$TEGAD_ENDERECOS:https://localhost:5001} {
	tls internal

	encode gzip

	# certificado raiz da CA interna, para instalar nos celulares/computadores
	handle /tegad-ca.crt {
		root * /data/caddy/pki/authorities/local
		rewrite * /root.crt
		header Content-Type application/x-x509-ca-cert
		header Content-Disposition "attachment; filename=tegad-ca.crt"
		file_server
	}

	handle {
		reverse_proxy app:5001
	}
}
