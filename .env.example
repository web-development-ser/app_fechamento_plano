# Copie para .env e preencha. Nunca versionar o .env.
SECRET_KEY=troque-por-um-valor-aleatorio-longo
# Aceita postgresql:// ou postgresql+psycopg:// (formato SQLAlchemy)
DATABASE_URL=postgresql+psycopg://usuario:senha@servidor:5432/app_fechameto_plano
# Banco exclusivo para testes (sera recriado pelos testes!)
TEST_DATABASE_URL=postgresql+psycopg://usuario:senha@servidor:5432/app_fechameto_plano_test
MAX_UPLOAD_MB=10

# --- Docker / HTTPS (PWA) ---
# Endereços de acesso ao sistema (IP e/ou nome do servidor), separados por vírgula.
# Ex.: TEGAD_ENDERECOS=https://10.2.0.10:5001, https://tegad.empresa.local:5001
TEGAD_ENDERECOS=https://localhost:5001
